# Local SQLite file by default; set these to a Turso database for deployment.
TURSO_DATABASE_URL=file:./invoiceflow.db
TURSO_AUTH_TOKEN=
# Public portfolio demo: no login; all visitors share the fictional workspace.
# Set false to require owner sign-in.
PUBLIC_DEMO_MODE=true
# Single-owner deployment sign-in. Generate a password hash with `npm run auth:hash-password`.
APP_LOGIN_EMAIL=
APP_LOGIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional live providers. Never commit real keys. Configure deployed values as Vercel secrets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=
RESEND_WEBHOOK_SECRET=
EMAIL_STATUS_MODE=poll
# Keep reminders off until a protected Vercel Cron schedule is configured.
REMINDER_JOB_SECRET=
REMINDER_SCHEDULER_ENABLED=false
INVOICEFLOW_BASE_URL=http://127.0.0.1:3000/
